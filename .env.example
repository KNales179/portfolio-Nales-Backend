# ============================================================
# PORTFOLIO BACKEND — ENVIRONMENT
# ============================================================
# Copy to .env and fill in. Never commit .env.

# --- Core ---
PORT=5000
MONGODB_URI=
JWT_SECRET=
JWT_EXPIRES_IN=1d

# --- Security (added in the auth hardening pass) ---

# Number of proxies in front of the app. Render = 1.
# Controls how req.ip is derived, which rate limiting and audit
# logs depend on. Defaults to 1 if unset.
TRUST_PROXY=1

# Comma-separated list of browser origins allowed to call the
# API with credentials. REQUIRED in production — if left empty
# the API accepts requests from any origin.
# e.g. https://knales179.github.io,https://your-domain.com
ALLOWED_ORIGINS=

# Separate signing secret for short-lived 2FA challenge tokens.
# Falls back to JWT_SECRET if unset; set it to a distinct value.
JWT_2FA_SECRET=

# 32-byte key (64 hex chars) used to encrypt TOTP 2FA secrets
# at rest. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# If unset, 2FA secrets are stored as plaintext (back-compat).
# Existing plaintext secrets keep working after you set this;
# they are re-encrypted the next time 2FA is set up.
ENCRYPTION_KEY=

# --- Integrations ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
GEOIP_DATABASE_URL=
TWO_FACTOR_ISSUER=Portfolio Admin
BREVO_API_KEY=
